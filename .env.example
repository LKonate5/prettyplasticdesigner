# Copy this file to .env for local development (that file is gitignored).
# In production (Vercel), set this in Project Settings → Environment Variables
# instead — never commit the real value.

# Resend API key used by api/send-email.ts to send the "Request a sample" /
# "Request a quote" / "Email to Pretty Plastic" messages. Get one at
# https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxx

# Optional verified-domain sender. Keep it different from the recipient so
# mailbox providers do not mistake the message for self-spoofing.
FROM_EMAIL=Pretty Plastic Designer <designer@prettyplastic.nl>

# Optional override for the fixed internal recipient. Defaults to
# info@prettyplastic.nl when omitted.
SALES_EMAIL=info@prettyplastic.nl

# ElevenLabs API key used by scripts/add-narration.mjs to voice the demo
# walkthrough (npm run narrate). Get one at
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=sk_xxxxxxxxx
